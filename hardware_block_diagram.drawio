        <mxCell id="mech_specimen" value="&lt;b&gt;TEST SPECIMEN / EXPERIMENTAL BENCH&lt;/b&gt;&lt;br&gt;• Multi-Story Building Scale Frame / SDOF Resonator&lt;br&gt;• Tuned Liquid Damper (TLD) / Base Isolation Bearings&lt;br&gt;• Structural Dynamic Resonance Investigation (1 - 15 Hz)&lt;br&gt;• Real-time destructive &amp;amp; non-destructive seismic analysis" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="1">
