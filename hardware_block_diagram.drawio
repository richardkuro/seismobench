        <mxCell id="title_box" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;SEISMOBENCH: PRECISION DUAL-STEPPER SHAKE TABLE CONTROLLER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px; color: #475569;&quot;&gt;COMPLETE HARDWARE ARCHITECTURE &amp;amp; SIGNAL WIRING BLOCK DIAGRAM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #64748B;&quot;&gt;ESP32-S3 Dual-Core (240MHz) | Dual TMC2209 SpreadCycle (1000mA RMS) | ADXL355 20-bit SPI Accelerometer | Web Serial Direct Stream (921,600 Baud)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="legend_box" value="&lt;b&gt;DIAGRAM BUS &amp;amp; SIGNAL LEGEND&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;━ Web Serial / Telemetry (921.6k Baud)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#059669;&quot;&gt;━ Hard Real-Time Step/Dir Pulses (GPIO)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#7C3AED;&quot;&gt;━ TMC Single-Wire UART Bus (115.2k Baud)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0891B2;&quot;&gt;━ High-Speed SPI Bus (5 MHz Mode 0)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#DC2626;&quot;&gt;━ DC Power Rails (VMOT 12/24V, 5V, 3.3V)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#D97706;&quot;&gt;━ Mechanical Timing Belt / Coupling&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
